SELECT

    movies.id,

    movies.title,

    COUNT(tickets.id) AS tickets_count

FROM movies

LEFT JOIN tickets ON tickets.movie_id = movies.id

GROUP BY movies.id

HAVING COUNT(tickets.id) &lt; 2

ORDER BY movies.id;</sql><current_tab id="0"/></tab_sql></sqlb_project>
