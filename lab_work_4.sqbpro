    orders.id,
    products.name AS product,
    customers.last_name || ' ' || customers.first_name AS customer,
    orders.order_date,
    orders.quantity,
    orders.status
FROM orders
JOIN products ON orders.product_id = products.id
JOIN customers ON orders.customer_id = customers.id;
INSERT INTO orders (product_id, customer_id, order_date, quantity, status)
VALUES (9999, 1, '2026-09-11', 1, 'Помилка');
SELECT * FROM orders;</sql><current_tab id="0"/></tab_sql></sqlb_project>
