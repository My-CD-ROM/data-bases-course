<?xml version="1.0" encoding="UTF-8"?><sqlb_project><db path="db pr2.db" readonly="0" foreign_keys="1" case_sensitive_like="0" temp_store="0" wal_autocheckpoint="1000" synchronous="2"/><attached/><window><main_tabs open="structure browser pragmas query" current="3"/></window><tab_structure><column_width id="0" width="300"/><column_width id="1" width="0"/><column_width id="2" width="100"/><column_width id="3" width="1042"/><column_width id="4" width="0"/><expanded_item id="0" parent="1"/><expanded_item id="1" parent="1"/><expanded_item id="2" parent="1"/><expanded_item id="3" parent="1"/></tab_structure><tab_browse><table title="cars" custom_title="0" dock_id="1" table="4,4:maincars"/><dock_state state="000000ff00000000fd00000001000000020000000000000000fc0100000001fb000000160064006f0063006b00420072006f00770073006500310100000000ffffffff0000012200ffffff000000000000000000000004000000040000000800000008fc00000000"/><default_encoding codec=""/><browse_table_settings/></tab_browse><tab_sql><sql name="SQL 1*">DROP TABLE IF EXISTS cars;

CREATE TABLE cars (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    brand TEXT NOT NULL,
    model TEXT NOT NULL,
    year INTEGER NOT NULL,
    price REAL NOT NULL,
    status TEXT
);

INSERT INTO cars (brand, model, year, price, status) VALUES
('Toyota', 'Camry', 2022, 28500.00, 'продано'),
('BMW', 'X5', 2023, 72000.00, 'у продажу'),
('Volkswagen', 'Passat', 2021, 24500.00, 'у продажу'),
('Audi', 'A6', 2022, 51000.00, 'заброньовано'),
('Skoda', 'Octavia', 2023, 23000.00, 'у продажу'),
('Mercedes-Benz', 'C-Class', 2024, 63000.00, 'у продажу');

-- Завдання 1
SELECT brand, model, year, price
FROM cars;

-- Завдання 2
SELECT brand, model, year
FROM cars
WHERE year &gt;= 2023;

-- Завдання 3
SELECT brand, model, year, price
FROM cars
LIMIT 3;

-- Завдання 4
INSERT INTO cars (brand, model, year, price, status)
VALUES ('Honda', 'Civic', 2022, 26000.00, NULL);

SELECT brand, model, status
FROM cars
WHERE status IS NULL;

SELECT brand, model, status
FROM cars
WHERE status IS NOT NULL;

-- Завдання 5
SELECT brand, model, year, price
FROM cars
WHERE year &gt;= 2022
AND price &lt; 60000;
</sql><current_tab id="0"/></tab_sql></sqlb_project>
